generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceCategory {
  WATER_COOLER
  STATIONARY
  PRINTER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  STEPS_COMPLETED
  RESOLVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

model Coordinator {
  id           String         @id @default(uuid())
  username     String         @unique // Default email address (e.g. coord@college.edu)
  notificationEmail String?   // Custom email override if updated in profile
  password     String
  name         String
  category     DeviceCategory @default(WATER_COOLER)
  roleTitle    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tickets      Ticket[]
}

model Device {
  id           String         @id @default(uuid())
  deviceCode   String         @unique
  name         String
  category     DeviceCategory @default(WATER_COOLER)
  location     String
  model        String         @default("V-80L")
  filterHealth Int            @default(64)
  lastService  DateTime       @default(now())
  createdAt    DateTime       @default(now())
  tickets      Ticket[]
}

model Ticket {
  id                String       @id @default(uuid())
  ticketNumber      String       @unique
  category          String
  specification     String
  severity          Severity     @default(MEDIUM)
  status            TicketStatus @default(OPEN)
  completedSteps    Int[]        @default([])  // Stores completed step numbers: e.g. [2, 3]
  lastStepTimestamp DateTime     @default(now())
  verifiedResolved  Boolean      @default(false)
  reporterName      String?
  reporterPhone     String?
  deviceId          String
  device            Device       @relation(fields: [deviceId], references: [id])
  coordinatorId     String?
  coordinator       Coordinator? @relation(fields: [coordinatorId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}